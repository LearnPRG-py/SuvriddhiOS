#!/bin/sh

start() {
    export XDG_RUNTIME_DIR=/tmp/runtime-root
    export CHROME_DATA_DIR=/root/chromium-data
    mkdir -p $XDG_RUNTIME_DIR $CHROME_DATA_DIR
    chmod 0700 $XDG_RUNTIME_DIR $CHROME_DATA_DIR
    export LD_LIBRARY_PATH=/usr/lib/chromium-browser:$LD_LIBRARY_PATH

    if [ ! -d "/root/www/wallpapers" ] && [ -d "/root/www.old/wallpapers" ]; then
        mv "/root/www.old/wallpapers" "/root/www/" 2>/dev/null || true
    fi

    if [ -d "/root/www.old/learn/data/topics/G01" ]; then
        mkdir -p "/root/www.old/learn/data/topics/Unity"
        for dir in /root/www.old/learn/data/topics/G*; do
            if [ -d "$dir" ]; then
                mv "$dir" "/root/www.old/learn/data/topics/Unity/" 2>/dev/null || true
            fi
        done
    fi

    if [ ! -d "/root/www/learn/data/topics/Unity" ] && [ -d "/root/www.old/learn/data/topics/Unity" ]; then
        mv "/root/www.old/learn/data/topics/Unity" "/root/www/learn/data/topics/" 2>/dev/null || true
    fi

    if [ ! -d "/root/www/learn/data/topics_math/Build" ] && [ -d "/root/www.old/learn/data/topics_math/Build" ]; then
        mv "/root/www.old/learn/data/topics_math/Build" "/root/www/learn/data/topics_math/" 2>/dev/null || true
    fi

    if [ ! -d "/root/www/learn/data/topics_math/Vids" ] && [ -d "/root/www.old/learn/data/topics_math/Vids" ]; then
        mv "/root/www.old/learn/data/topics_math/Vids" "/root/www/learn/data/topics_math/" 2>/dev/null || true
    fi

    (
    echo "Starting network setup..."
    sleep 1
    ip link set wlan0 up 2>/dev/null || true
    sleep 1
    if [ -f /etc/wpa_supplicant.conf ] && grep -q "ssid" /etc/wpa_supplicant.conf; then
        sleep 2
        wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf 2>/dev/null || true
        sleep 2
        udhcpc -i wlan0 -n -T 10 -t 10 2>/dev/null || true
        sleep 2
        ntpd -g -q -p pool.ntp.org 2>/dev/null || true
    else
        echo "No WiFi config found, skipping network setup"
    fi
    ) &

    /root/server & 
    busybox httpd -h /root/www -p 8080 &
    busybox httpd -h /root/www/build -p 8081 &
    busybox httpd -h /root/www/learn -p 8082 &

    sleep 5

    weston --backend=drm-backend.so --idle-time=0 &
    
    while [ ! -e "$XDG_RUNTIME_DIR/wayland-1" ]; do
        sleep 0.2
    done
}

stop() {
    killall -9 chromium-browser 2>/dev/null
    killall -9 httpd 2>/dev/null
    killall -9 weston 2>/dev/null
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
